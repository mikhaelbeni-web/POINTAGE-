# Copie ce fichier en .env.local et remplis avec TA config Supabase
# (Supabase > Project Settings > API : « Project URL » et clé « anon / publishable »).
# Ces deux valeurs sont publiques (elles sont dans l'app). Ne mets JAMAIS ici la clé service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uniquement pour le script de copie depuis l'ancienne base (scripts/migrate-firestore-to-supabase.mjs)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
